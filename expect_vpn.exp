#!/usr/bin/expect -f

set username "safiullah"
set secret_key CQDKAZCPPZY3SLCBK6VZP5DU74
set vpn_server "d2s.antc.com"

spawn sudo openconnect $vpn_server

# Generate the authenticator code using oathtool
set otp [exec oathtool --totp --base32 $secret_key]
expect "Please enter your username and password."
send "$username\r"
expect "Password:"
send "vpn@d2s@321$otp\r"
interact
